{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sequence-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/*"],
  },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "sequence-atlas" }],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "sequence-atlas.dwainosaur.com", "custom_domain": true }],
}
